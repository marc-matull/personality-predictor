# Data and model artifacts (never committed, see README for how to obtain/recreate them)
data/*
!data/.gitkeep
models/*
!models/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Safety net: trained models and raw data files must never be committed,
# not even by accident outside of data/ and models/
*.joblib
*.pkl
*.csv

# Streamlit secrets (not used in this project, ignored for safety)
.streamlit/secrets.toml
